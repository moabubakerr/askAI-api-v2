# Source data is committed verbatim. Without this, a Windows clone with
# core.autocrlf=true rewrites line endings on checkout, so the bytes the ETL
# reads differ between a Windows workstation and the Linux VM. These files are
# SCAI exports, not source code — they should round-trip unchanged.
data/** -text

# Belt and braces: the QC workbook is a zip container. A text conversion would
# corrupt it outright.
*.xlsx binary

# Shell scripts run inside Linux containers. A CRLF shebang line fails with the
# famously unhelpful "no such file or directory".
*.sh text eol=lf
