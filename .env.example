# Copy to .env next to docker-compose.yml and set real passwords.
#   cp .env.example .env
#
# Only the database secrets live here. The model endpoints are pinned in
# docker-compose.yml rather than made configurable, because they are properties
# of the VM (hostnames on the `runtimes` network, and the exact served model
# name vLLM answers to) — not things to vary per deployment.

# Superuser/owner role for the DB. The ETL connects as this; the app never does.
POSTGRES_DB=scai_indicators
POSTGRES_USER=scai_rw
POSTGRES_PASSWORD=change_me_rw

# The app's SELECT-only role. Created by docker/initdb/02-roles.sh on first boot.
# Changing this after the volume exists does NOT update the role — you would
# need to ALTER ROLE scai_ro WITH PASSWORD ... by hand.
SCAI_RO_PASSWORD=change_me_ro

# The EXISTING Docker network that vllm and tei are on. On hmktech-vm-02 this is
# askai-net, verified by:
#   docker network inspect askai-net --format '{{range .Containers}}{{.Name}} {{end}}'
#   -> askai-api-askai-api-1 vllm tei
# There is no network called "runtimes" on that host. A wrong value fails at `up`
# with "network ... declared as external, but could not be found" — a clean
# failure, not a silent misconfiguration.
RUNTIMES_NETWORK=askai-net

# Host port for the API. Taken on hmktech-vm-02: 17000 (askai-web), 17800 (tei),
# 17900 (askai-api v1), 8000, 3000. 18000 is free and puts v2 beside v1 rather
# than on top of it.
API_PORT=18000

LOG_LEVEL=INFO

# --- Admin API -------------------------------------------------------------
# /admin/* returns message logs, which contain whatever users typed. Unset, the
# admin endpoints refuse to serve (503) rather than default to open. Send the
# value as the X-Admin-Key header.
#   openssl rand -hex 32
ADMIN_API_KEY=

# Interactive login for the dashboard (POST /admin/login). ONE account.
# ADMIN123 is a placeholder for local work and is published in this repo —
# change it before the service is reachable by anyone outside the team. The API
# logs a warning on every startup while it is still the default.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ADMIN123
# How long a login lasts before signing in again.
ADMIN_SESSION_HOURS=8
