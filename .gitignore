# data/ IS tracked here, by explicit decision — it makes `git clone` on the VM
# self-contained, with no separate file transfer before the ETL can run.
# Note what that means: this repository is public, so the SCAI exports and
# AskAI-test (4).xlsx (the QC feedback log) are public with it.
# The CSVs are still excluded from the Docker image (see .dockerignore) and
# bind-mounted at load time, so the image itself carries no data.

# Real credentials. Only .env.example, which holds placeholders, is tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
